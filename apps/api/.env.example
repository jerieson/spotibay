# Local dev only (pnpm dev). Copy to apps/api/.env.
# The root .env is for Docker and uses container hostnames; this one uses localhost.
# Match the ports to POSTGRES_PORT / REDIS_PORT used for docker-compose.dev.yml.
DATABASE_URL=postgres://spotibay:spotibay@localhost:5433/spotibay
REDIS_URL=redis://localhost:6379
# 32+ random bytes, base64: openssl rand -base64 32
JWT_SECRET=
RECOVERY_HMAC_SECRET=
# Required to add tracks by link (YouTube Data API v3)
YOUTUBE_API_KEY=
# Optional: GIFs and stickers in chat. Get a key at partner.klipy.com
KLIPY_API_KEY=
# Admin panel at /admin. Leave the hash empty to switch it off.
# Create one with: pnpm --filter api hash-password <password>
# Quote the value (single quotes) because argon2 hashes contain $ characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Optional in dev. In production the public URL: requests from pages on other origins are refused.
# APP_URL=http://localhost:5173

# Optional: fatal|error|warn|info|debug|trace|silent (default info)
# LOG_LEVEL=info
