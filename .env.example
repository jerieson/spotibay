NODE_ENV=production
DOMAIN=listen.example.com
APP_URL=https://listen.example.com

DATABASE_URL=postgres://listen:change_me@postgres:5432/listen
POSTGRES_USER=listen
POSTGRES_PASSWORD=change_me
POSTGRES_DB=listen

REDIS_URL=redis://redis:6379

YOUTUBE_API_KEY=

JWT_SECRET=                 # 32+ random bytes, base64
RECOVERY_HMAC_SECRET=       # 32+ random bytes, base64

ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=        # from: pnpm --filter api hash-password <password>
