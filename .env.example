NODE_ENV=production
DOMAIN=spotibay.example.com
# Must match the address people open exactly (scheme + host): other origins are refused.
APP_URL=https://spotibay.example.com

# Docker ignores DATABASE_URL/REDIS_URL: compose builds them from POSTGRES_* and the service names.
DATABASE_URL=postgres://spotibay:change_me@postgres:5432/spotibay
POSTGRES_USER=spotibay
POSTGRES_PASSWORD=change_me
POSTGRES_DB=spotibay

REDIS_URL=redis://redis:6379

YOUTUBE_API_KEY=
KLIPY_API_KEY=              # optional: GIFs and stickers in chat (partner.klipy.com)
ODESLI_API_KEY=             # recommended: match songs via song.link instead of a 100-unit YouTube search (developers@song.link)
LASTFM_API_KEY=             # optional: similar songs for "For you" and autoplay (last.fm/api/account/create)
ANALYTICS_TIMEZONE=         # optional: zone for the admin dashboard's days and hours (default Asia/Manila)

JWT_SECRET=                 # 32+ random bytes, base64
RECOVERY_HMAC_SECRET=       # 32+ random bytes, base64

ADMIN_USERNAME=admin
# Hash from: pnpm --filter api hash-password <password>
# Keep it in single quotes: the hash contains $ characters that Docker Compose would expand.
ADMIN_PASSWORD_HASH=''

# Cloudflare-tunnel VM stack (docker-compose.vm.yml)
HTTP_PORT=8083
# 127.0.0.1 if cloudflared runs on the host; 172.17.0.1 (docker0) if it runs in a container
HTTP_BIND=127.0.0.1

# Optional: fatal|error|warn|info|debug|trace|silent (default info)
# LOG_LEVEL=info
